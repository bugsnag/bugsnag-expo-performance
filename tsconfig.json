{
  "include": ["src/*"],
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "preserve",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "noEmitOnError": true
  }
}
